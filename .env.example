# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Server-only. These never reach the browser — every Supabase call happens
# inside the /api Serverless Functions.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional but recommended for a private household tool: if set, creating an
# account requires this exact code. Without it, anyone who finds the URL can
# register and edit (or reset) the shared list. Pick any hard-to-guess string.
# SIGNUP_INVITE_CODE=some-long-random-phrase
